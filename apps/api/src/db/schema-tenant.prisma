// ─── Accounts Receivable ──────────────────────────────────────────────────────

model Customer {
  id               String       @id @default(uuid())
  entityId         String       @map("entity_id")
  name             String
  code             String
  type             CustomerType @default(CORPORATE)
  creditLimit      Decimal?     @map("credit_limit") @db.Decimal(18, 4)
  currency         String       @db.Char(3)
  paymentTermsDays Int          @default(30) @map("payment_terms_days")
  billingContact   Json?        @map("billing_contact")
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  entity           Entity       @relation(fields: [entityId], references: [id])
  arInvoices       ARInvoice[]
  arReceipts       ARReceipt[]

  @@unique([entityId, code])
  @@index([entityId, isActive])
  @@map("customers")
}

model ARInvoice {
  id               String          @id @default(uuid())
  entityId         String          @map("entity_id")
  customerId       String          @map("customer_id")
  invoiceNumber    String          @map("invoice_number")
  invoiceDate      DateTime        @map("invoice_date")
  dueDate          DateTime        @map("due_date")
  currency         String          @db.Char(3)
  /// Gross invoice total — what the customer owes, tax included.
  /// Invariant: amount = netAmount + taxAmount.
  amount           Decimal         @db.Decimal(18, 4)
  /// Revenue portion, excluding output tax. Backfilled to `amount` for
  /// invoices created before tax was tracked, where taxAmount is 0.
  netAmount        Decimal         @default(0) @map("net_amount") @db.Decimal(18, 4)
  /// Output tax portion, credited to the tax code's outputTaxAccount on post.
  taxAmount        Decimal         @default(0) @map("tax_amount") @db.Decimal(18, 4)
  taxCodeId        String?         @map("tax_code_id")
  functionalAmount Decimal         @map("functional_amount") @db.Decimal(18, 4)
  fxRate           Decimal         @map("fx_rate") @db.Decimal(14, 8)
  amountPaid       Decimal         @default(0) @map("amount_paid") @db.Decimal(18, 4)
  status           ARInvoiceStatus @default(DRAFT)
  glJournalId      String?         @map("gl_journal_id")
  notes            String?
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  entity           Entity          @relation(fields: [entityId], references: [id])
  customer         Customer        @relation(fields: [customerId], references: [id])
  taxCode          TaxCode?        @relation(fields: [taxCodeId], references: [id])
  allocations      ARAllocation[]

  @@unique([entityId, customerId, invoiceNumber])
  @@index([entityId, status, dueDate])
  @@index([customerId, invoiceDate])
  @@map("ar_invoices")
}

model ARReceipt {
  id            String         @id @default(uuid())
  entityId      String         @map("entity_id")
  customerId    String         @map("customer_id")
  receiptDate   DateTime       @map("receipt_date")
  currency      String         @db.Char(3)
  amount        Decimal        @db.Decimal(18, 4)
  bankAccountId String?        @map("bank_account_id")
  reference     String?
  glJournalId   String?        @map("gl_journal_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  entity        Entity         @relation(fields: [entityId], references: [id])
  customer      Customer       @relation(fields: [customerId], references: [id])
  bankAccount   BankAccount?   @relation(fields: [bankAccountId], references: [id])
  allocations   ARAllocation[]

  @@index([entityId, customerId, receiptDate])
  @@index([bankAccountId])
  @@map("ar_receipts")
}

model ARAllocation {
  id              String    @id @default(uuid())
  receiptId       String    @map("receipt_id")
  invoiceId       String    @map("invoice_id")
  allocatedAmount Decimal   @map("allocated_amount") @db.Decimal(18, 4)
  createdAt       DateTime  @default(now()) @map("created_at")
  receipt         ARReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoice         ARInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([receiptId, invoiceId])
  @@index([invoiceId])
  @@map("ar_allocations")
}

// ─── Audit Trail ──────────────────────────────────────────────────────────────

model AuditEvent {
  id           String   @id @default(uuid())
  entityId     String   @map("entity_id")
  userId       String?  @map("user_id")
  eventType    String   @map("event_type")
  resourceType String   @map("resource_type")
