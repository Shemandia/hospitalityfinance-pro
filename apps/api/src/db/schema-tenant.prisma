  runAt               DateTime?                @map("run_at")
  createdAt           DateTime                 @default(now()) @map("created_at")
  parentEntity        Entity                   @relation("ConsolidationParent", fields: [parentEntityId], references: [id])
  entityResults       ConsolidationRunEntity[]

  @@index([parentEntityId, periodId])
  @@map("consolidation_runs")
}

model ConsolidationRunEntity {
  id                 String           @id @default(uuid())
  consolidationRunId String           @map("consolidation_run_id")
  entityId           String           @map("entity_id")
  localCurrency      String           @map("local_currency") @db.Char(3)
  closingRate        Decimal          @map("closing_rate") @db.Decimal(14, 8)
  averageRate        Decimal          @map("average_rate") @db.Decimal(14, 8)
  translatedDebits   Decimal          @map("translated_debits") @db.Decimal(18, 4)
  translatedCredits  Decimal          @map("translated_credits") @db.Decimal(18, 4)
  ctaAmount          Decimal          @map("cta_amount") @db.Decimal(18, 4)
  createdAt          DateTime         @default(now()) @map("created_at")
  consolidationRun   ConsolidationRun @relation(fields: [consolidationRunId], references: [id], onDelete: Cascade)
  entity             Entity           @relation("ConsolidationEntity", fields: [entityId], references: [id])

  @@unique([consolidationRunId, entityId])
  @@map("consolidation_run_entities")
}

// ─── Integration / Connectors ─────────────────────────────────────────────────

model InterfaceDefinition {
  id            String   @id @default(uuid())
  entityId      String   @map("entity_id")
  name          String
  connectorType String   @map("connector_type") // OPERA_CLOUD | OPERA_SUN | SIMPHONY_POS | SKY_JANA | BANK | PAYROLL | PROCUREMENT | CUSTOM
  sourceFormat  String   @map("source_format") // CSV | JSON | XML | EXCEL | MT940 | FIXED_WIDTH | SAF
  targetType    String   @default("GL_JOURNAL") @map("target_type") // GL_JOURNAL | AP_INVOICE | SUPPLIER_SYNC
  description   String?
  isActive      Boolean  @default(true) @map("is_active")
  fieldMappings Json     @map("field_mappings") // FieldMappingRule[]
  parseOptions  Json?    @map("parse_options") // ParseOptions (delimiter, skipRows, fixedWidthColumns, filterRules, groupBy, etc.)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  entity        Entity   @relation(fields: [entityId], references: [id])

  @@unique([entityId, name])
  @@index([entityId, connectorType])
  @@map("interface_definitions")
}

model ConnectorMapping {
  id            String   @id @default(uuid())
  entityId      String   @map("entity_id")
  connectorType String   @map("connector_type")
  sourceCode    String   @map("source_code")
  glAccountId   String?  @map("gl_account_id")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  entity        Entity   @relation(fields: [entityId], references: [id])
  glAccount     Account? @relation(fields: [glAccountId], references: [id])

  @@unique([entityId, connectorType, sourceCode])
  @@map("connector_mappings")
}

model ImportLog {
  id              String   @id @default(uuid())
  entityId        String   @map("entity_id")
  connectorType   String   @map("connector_type")
  businessDate    DateTime @map("business_date") @db.Date
  status          String // RUNNING | SUCCESS | FAILED | PARTIAL
  recordsTotal    Int      @default(0) @map("records_total")
  recordsImported Int      @default(0) @map("records_imported")
  recordsFailed   Int      @default(0) @map("records_failed")
  errorDetails    Json?    @map("error_details")
  glJournalId     String?  @map("gl_journal_id")
  createdAt       DateTime @default(now()) @map("created_at")
  entity          Entity   @relation(fields: [entityId], references: [id])

  @@index([entityId, connectorType, businessDate])
  @@map("import_logs")
}

// ─── PMS Statistics (for KPI calculations) ────────────────────────────────────

model PMSStatistic {
  id             String   @id @default(uuid())
  entityId       String   @map("entity_id")
  statDate       DateTime @map("stat_date") @db.Date
  availableRooms Int      @map("available_rooms")
  occupiedRooms  Int      @map("occupied_rooms")
  source         String   @default("MANUAL")
  createdAt      DateTime @default(now()) @map("created_at")
  entity         Entity   @relation(fields: [entityId], references: [id])

  @@unique([entityId, statDate])
  @@index([entityId, statDate])
  @@map("pms_statistics")
}

// ─── Bank Reconciliation ──────────────────────────────────────────────────────

model BankStatement {
  id             String            @id @default(uuid())
  entityId       String            @map("entity_id")
  accountId      String            @map("account_id")
  statementDate  DateTime          @map("statement_date") @db.Date
  openingBalance Decimal           @map("opening_balance") @db.Decimal(18, 4)
  closingBalance Decimal           @map("closing_balance") @db.Decimal(18, 4)
  currency       String            @db.Char(3)
  createdAt      DateTime          @default(now()) @map("created_at")
  entity         Entity            @relation(fields: [entityId], references: [id])
  account        Account           @relation(fields: [accountId], references: [id])
  transactions   BankTransaction[]

  @@unique([entityId, accountId, statementDate])
  @@index([entityId, accountId])
  @@map("bank_statements")
}

model BankTransaction {
  id              String        @id @default(uuid())
  bankStatementId String        @map("bank_statement_id")
  valueDate       DateTime      @map("value_date") @db.Date
  description     String
  amount          Decimal       @db.Decimal(18, 4)
  currency        String        @db.Char(3)
  reference       String?
  isReconciled    Boolean       @default(false) @map("is_reconciled")
  journalLineId   String?       @map("journal_line_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  bankStatement   BankStatement @relation(fields: [bankStatementId], references: [id], onDelete: Cascade)
  journalLine     JournalLine?  @relation(fields: [journalLineId], references: [id])

  @@index([bankStatementId, valueDate])
  @@index([isReconciled])
  @@map("bank_transactions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Transfer Desk (Sprint 2 — see HFP_TransferDesk_TechnicalSpecification_v1_0.md)
//
// Tenant-wide tables: profiles, formats, transformations, lookups, automations,
// folders, files, executions are SHARED across all entities in a tenant. They
// are isolated by the tenant DB boundary; no row-level entity_id needed.
//
// Per-entity table: transfer_journal_ranges has business_unit (entity_id) per
// spec TD-DB-006 — journal range control state is per BU × ledger.
//
// RLS: enabled on all TD tables for consistency with the rest of the schema.
// Most policies are open (USING (true)) because the tenant DB itself is the
// isolation boundary. The policy on transfer_journal_ranges enforces the
// standard entity_id = app_current_entity_id() pattern.
// ─────────────────────────────────────────────────────────────────────────────

enum ProfileType {
  IMPORT
  EXPORT
  PROCESS
  INTERNAL_TRANSFER
  EXTERNAL_TRANSFER
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ExecutionLogStatus {
  SUCCESS
  FAILED
  SKIPPED
}

enum FormatClassification {
  DELIMITED
  SINGLE_FIXED
  MULTIPLE_FIXED
  OTHER_FLAT
  USER_XML
  SIMPLE_XML
}

enum ScriptType {
  TML
  XSL
}

enum LookupValueType {
  CONSTANT
  COPY
  MAP_TO
  OMIT
  REVERSE_SIGN
}

enum SavePayloadOption {
  NONE
  INPUT
  OUTPUT
  BOTH
}

// ── TD-DB-003: transfer_profiles ─────────────────────────────────────────────

model TransferProfile {
  id               String            @id @default(uuid())
  name             String            @unique
  description      String?
  profileType      ProfileType       @map("profile_type")
  /// External component (e.g. "OPERA_CLOUD"); free-text to allow custom systems
  sourceComponent  String?           @map("source_component")
  /// HFP target component (GL_JOURNAL, AP_INVOICE, AR_INVOICE, etc.)
  targetComponent  String?           @map("target_component")
  sourceFormatId   String?           @map("source_format_id")
  targetFormatId   String?           @map("target_format_id")
  transformationId String?           @map("transformation_id")
  filterId         String?           @map("filter_id")
  /// Runtime parameters (JSONB) — e.g. ledger, posting_options, file_handling
  sourceParams     Json?             @map("source_params")
  targetParams     Json?             @map("target_params")
  /// Whether this profile passes its own validation rules; false blocks execute
  isValid          Boolean           @default(false) @map("is_valid")
  /// Increments on every save; profile_versions captures the snapshot
  version          Int               @default(1)
  /// System profiles ship with every tenant and cannot be deleted
  isSystem         Boolean           @default(false) @map("is_system")
  /// Soft delete flag
  isActive         Boolean           @default(true) @map("is_active")
  /// Save behavior: NONE / INPUT / OUTPUT / BOTH
  savePayload      SavePayloadOption  @default(NONE) @map("save_payload")
  reviewMode       TransferReviewMode @default(HOLD) @map("review_mode")
  createdById      String?            @map("created_by")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  sourceFormat    TransferFormat?          @relation("TransferProfileSourceFormat", fields: [sourceFormatId], references: [id])
  targetFormat    TransferFormat?          @relation("TransferProfileTargetFormat", fields: [targetFormatId], references: [id])
  transformation  TransferTransformation?  @relation(fields: [transformationId], references: [id])
  filter          TransferFilter?          @relation(fields: [filterId], references: [id])
  versions        TransferProfileVersion[]
  journalRanges   TransferJournalRange[]
  executions      TransferExecution[]
  automationSteps TransferAutomationStep[]

  @@index([profileType, isActive])
  @@map("transfer_profiles")
}

// ── TD-DB-004: transfer_profile_versions ─────────────────────────────────────

model TransferProfileVersion {
  id         String   @id @default(uuid())
  profileId  String   @map("profile_id")
  version    Int
  /// Full snapshot of the profile at this version (JSONB)
  snapshot   Json
  changedBy  String?  @map("changed_by")
  changedAt  DateTime @default(now()) @map("changed_at")
  changeNote String?  @map("change_note")

  profile TransferProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, version])
  @@index([profileId, changedAt])
  @@map("transfer_profile_versions")
}

// ── TD-DB-005: transfer_filters ──────────────────────────────────────────────

model TransferFilter {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String?
  /// Component this filter applies to (e.g. "GL_JOURNAL")
  sourceComponent String   @map("source_component")
  /// AND/OR clause tree as JSONB. Shape: { op: 'AND'|'OR', clauses: [...] }
  filterClauses   Json     @map("filter_clauses")
  createdById     String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  profiles TransferProfile[]

  @@map("transfer_filters")
}

// ── TD-DB-006: transfer_journal_ranges ───────────────────────────────────────
//
// Per-profile, per-business-unit, per-ledger journal number range state.
// Used by export profiles to remember "I last exported up to journal #1234,
// resume from #1235 next time". This is the ONLY TD table that's entity-scoped
// (business_unit = entity_id) per spec TD-DB-006.

model TransferJournalRange {
  id                String   @id @default(uuid())
  profileId         String   @map("profile_id")
  /// Business unit / entity this range applies to
  entityId          String   @map("entity_id")
  /// Single-character ledger code (A-K per SunSystems convention)
  ledger            String   @db.Char(1)
  /// Inclusive start of range (BIGINT to support high journal numbers)
  journalNumberFrom BigInt   @map("journal_number_from")
  /// Inclusive end of range — last successfully exported journal
  journalNumberTo   BigInt   @map("journal_number_to")
  /// FK to the execution that last advanced this range
  lastExecutionId   String?  @map("last_execution_id")
  updatedAt         DateTime @updatedAt @map("updated_at")

  profile TransferProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, entityId, ledger])
  @@index([entityId])
  @@map("transfer_journal_ranges")
}

// ── TD-DB-007: transfer_automations ──────────────────────────────────────────

model TransferAutomation {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isEnabled   Boolean  @default(true) @map("is_enabled")
  createdById String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  steps      TransferAutomationStep[]
  schedules  TransferAutomationSchedule[]
  executions TransferExecution[]

  @@map("transfer_automations")
}

// ── TD-DB-008: transfer_automation_steps ─────────────────────────────────────

model TransferAutomationStep {
  id                   String  @id @default(uuid())
  automationId         String  @map("automation_id")
  profileId            String  @map("profile_id")
  stepOrder            Int     @map("step_order")
  failOnError          Boolean @default(true) @map("fail_on_error")
  /// Per-step parameter overrides; merged onto profile.sourceParams at run time
  sourceParamOverrides Json?   @map("source_param_overrides")
  targetParamOverrides Json?   @map("target_param_overrides")

  automation TransferAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  profile    TransferProfile    @relation(fields: [profileId], references: [id])

  @@unique([automationId, stepOrder])
  @@index([profileId])
  @@map("transfer_automation_steps")
}

// ── TD-DB-009: transfer_automation_schedules ─────────────────────────────────

model TransferAutomationSchedule {
  id              String    @id @default(uuid())
  automationId    String    @map("automation_id")
  /// Standard 5-field cron expression
  cronExpression  String    @map("cron_expression")
  /// IANA timezone (e.g. "Africa/Dar_es_Salaam"); next_run_at is stored in UTC
  timezone        String
  isActive        Boolean   @default(true) @map("is_active")
  /// User the automation runs as (Keycloak sub); needed for tenant context
  runAsUser       String?   @map("run_as_user")
  nextRunAt       DateTime? @map("next_run_at")
  /// BullMQ repeat job key — used to deregister the schedule
  bullmqRepeatKey String?   @map("bullmq_repeat_key")
  createdAt       DateTime  @default(now()) @map("created_at")

  automation TransferAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([nextRunAt])
  @@map("transfer_automation_schedules")
}

// ── TD-DB-010: transfer_formats (FSD) ────────────────────────────────────────

model TransferFormat {
  id               String               @id @default(uuid())
  name             String               @unique
  description      String?
  classification   FormatClassification
  /// Raw FSD XML — the source-of-truth definition
  fsdXml           String               @map("fsd_xml") @db.Text
  /// Optional GUI editor state (visual designer position, palette, etc.)
  guiState         Json?                @map("gui_state")
  /// True for pre-built system formats that cannot be deleted
  isSystem         Boolean              @default(false) @map("is_system")
  isValid          Boolean              @default(false) @map("is_valid")
  validationErrors Json?                @map("validation_errors")
  createdById      String?              @map("created_by")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  sourceProfiles   TransferProfile[]        @relation("TransferProfileSourceFormat")
  targetProfiles   TransferProfile[]        @relation("TransferProfileTargetFormat")
  sourceTransforms TransferTransformation[] @relation("TransferTransformationSourceFormat")
  targetTransforms TransferTransformation[] @relation("TransferTransformationTargetFormat")

  @@index([classification])
  @@map("transfer_formats")
}

// ── TD-DB-011: transfer_transformations (TML) ────────────────────────────────

model TransferTransformation {
  id               String     @id @default(uuid())
  name             String     @unique
  description      String?
  scriptType       ScriptType @default(TML) @map("script_type")
  sourceFormatId   String?    @map("source_format_id")
  targetFormatId   String?    @map("target_format_id")
  sourceComponent  String?    @map("source_component")
  targetComponent  String?    @map("target_component")
  /// Raw TML XML — the source-of-truth definition
  tmlXml           String?    @map("tml_xml") @db.Text
  /// Parsed TML rules as JSONB (for the visual mapper)
  rulesJson        Json?      @map("rules_json")
  /// User-defined JS function library (CDATA-wrapped JS)
  functionsJson    Json?      @map("functions_json")
  isSystem         Boolean    @default(false) @map("is_system")
  isValid          Boolean    @default(false) @map("is_valid")
  validationErrors Json?      @map("validation_errors")
  createdById      String?    @map("created_by")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  sourceFormat TransferFormat?   @relation("TransferTransformationSourceFormat", fields: [sourceFormatId], references: [id])
  targetFormat TransferFormat?   @relation("TransferTransformationTargetFormat", fields: [targetFormatId], references: [id])
  profiles     TransferProfile[]

  @@map("transfer_transformations")
}

// ── TD-DB-012: transfer_lookup_tables ────────────────────────────────────────

model TransferLookupTable {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdById String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  columns TransferLookupColumn[]
  rows    TransferLookupRow[]

  @@map("transfer_lookup_tables")
}

// ── TD-DB-013: transfer_lookup_columns ───────────────────────────────────────

model TransferLookupColumn {
  id          String @id @default(uuid())
  tableId     String @map("table_id")
  name        String
  columnOrder Int    @map("column_order")

  table  TransferLookupTable   @relation(fields: [tableId], references: [id], onDelete: Cascade)
  values TransferLookupValue[]

  @@unique([tableId, name])
  @@unique([tableId, columnOrder])
  @@map("transfer_lookup_columns")
}

// ── TD-DB-014: transfer_lookup_rows ──────────────────────────────────────────
//
// Range-based row matching uses ALPHABETICAL collation, NOT numeric.
// Always zero-pad numeric values when defining ranges (per spec TD-BL-021).

model TransferLookupRow {
  id           String  @id @default(uuid())
  tableId      String  @map("table_id")
  /// Business unit scope: NULL = global data (matches any BU)
  businessUnit String? @map("business_unit")
  /// Inclusive lower bound (alpha-collated)
  rangeFrom    String  @map("range_from")
  /// Inclusive upper bound (alpha-collated)
  rangeTo      String  @map("range_to")
  rowOrder     Int     @map("row_order")

  table  TransferLookupTable   @relation(fields: [tableId], references: [id], onDelete: Cascade)
  values TransferLookupValue[]

  @@index([tableId, businessUnit, rangeFrom, rangeTo])
  @@index([tableId, rowOrder])
  @@map("transfer_lookup_rows")
}

// ── TD-DB-015: transfer_lookup_values ────────────────────────────────────────

model TransferLookupValue {
  id         String          @id @default(uuid())
  rowId      String          @map("row_id")
  columnId   String          @map("column_id")
  valueType  LookupValueType @map("value_type")
  /// Parameter for the value type (the constant string, the source field path, etc.)
  valueParam String?         @map("value_param")
  isDefault  Boolean         @default(false) @map("is_default")

  row    TransferLookupRow    @relation(fields: [rowId], references: [id], onDelete: Cascade)
  column TransferLookupColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@unique([rowId, columnId])
  @@map("transfer_lookup_values")
}

// ── TD-DB-016: transfer_folders ──────────────────────────────────────────────

model TransferFolder {
  id          String   @id @default(uuid())
  name        String
  description String?
  parentId    String?  @map("parent_id")
  /// S3 key prefix where files in this folder are stored (must be unique)
  s3Prefix    String   @unique @map("s3_prefix")
  createdById String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent   TransferFolder?        @relation("TransferFolderHierarchy", fields: [parentId], references: [id])
  children TransferFolder[]       @relation("TransferFolderHierarchy")
  access   TransferFolderAccess[]
  files    TransferFile[]

  @@unique([parentId, name])
  @@map("transfer_folders")
}

// ── TD-DB-017: transfer_folder_access ────────────────────────────────────────

model TransferFolderAccess {
  id        String  @id @default(uuid())
  folderId  String  @map("folder_id")
  /// Role identifier (e.g. "transfer:user", "transfer:designer")
  roleName  String  @map("role_name")
  /// What this role can do in this folder
  canRead   Boolean @default(true) @map("can_read")
  canWrite  Boolean @default(false) @map("can_write")
  canDelete Boolean @default(false) @map("can_delete")

  folder TransferFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([folderId, roleName])
  @@map("transfer_folder_access")
}

// ── TD-DB-018: transfer_files ────────────────────────────────────────────────

model TransferFile {
  id           String   @id @default(uuid())
  folderId     String   @map("folder_id")
  filename     String
  /// Full S3 key (folder.s3Prefix + filename + uuid for collision-free)
  s3Key        String   @unique @map("s3_key")
  fileSize     BigInt   @map("file_size")
  contentType  String   @map("content_type")
  encoding     String   @default("UTF-8")
  /// JSONB blob for arbitrary metadata (origin profile, etc.)
  metadata     Json?
  uploadedById String?  @map("uploaded_by")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  folder TransferFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId, uploadedAt])
  @@map("transfer_files")
}

// ── TD-DB-001: transfer_executions ───────────────────────────────────────────
//
// One row per profile execution. Tracked through QUEUED → RUNNING →
// COMPLETED/FAILED/CANCELLED. Per-record details live in transfer_execution_logs.

model TransferExecution {
  id                  String          @id @default(uuid())
  profileId           String          @map("profile_id")
  /// Set when this execution is part of an automation pipeline
  automationId        String?         @map("automation_id")
  automationStepOrder Int?            @map("automation_step_order")
  status              ExecutionStatus @default(QUEUED)
  /// BullMQ job ID for cancellation and progress streaming
  jobId               String?         @map("job_id")
  /// Triggering user (Keycloak sub)
  triggeredBy         String?         @map("triggered_by")
  recordsTotal        Int             @default(0) @map("records_total")
  recordsSucceeded    Int             @default(0) @map("records_succeeded")
  recordsFailed       Int             @default(0) @map("records_failed")
  /// S3 key of the saved input payload (when save_payload includes INPUT)
  inputPayloadKey     String?         @map("input_payload_key")
  outputPayloadKey    String?         @map("output_payload_key")
  errorMessage        String?         @map("error_message") @db.Text
  /// Snapshot of the runtime parameters used for this execution
  runtimeParams       Json?           @map("runtime_params")
  startedAt           DateTime?       @map("started_at")
  finishedAt          DateTime?       @map("finished_at")
  createdAt           DateTime        @default(now()) @map("created_at")

  profile    TransferProfile        @relation(fields: [profileId], references: [id])
  automation TransferAutomation?    @relation(fields: [automationId], references: [id])
  logs       TransferExecutionLog[]

  @@index([profileId, createdAt])
  @@index([status])
  @@index([automationId, automationStepOrder])
  @@map("transfer_executions")
}

// ── TD-DB-002: transfer_execution_logs ───────────────────────────────────────
//
// One row per source record processed. BIGSERIAL primary key for sortable order.

model TransferExecutionLog {
  id              BigInt             @id @default(autoincrement())
  executionId     String             @map("execution_id")
  recordIndex     Int                @map("record_index")
  status          ExecutionLogStatus
  /// Source record as JSONB (parsed from FSD)
  sourceData      Json?              @map("source_data")
  /// Transformed output as JSONB (after TML)
  transformedData Json?              @map("transformed_data")
  errorCode       String?            @map("error_code")
  errorMessage    String?            @map("error_message") @db.Text

  execution TransferExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, recordIndex])
  @@index([executionId, status])
  @@map("transfer_execution_logs")
}

// ── TD-DB-019: transfer_batches ──────────────────────────────────────────────

model TransferBatch {
  id              String              @id @default(uuid())
  entityId        String              @map("entity_id")
  profileId       String              @map("profile_id")
  executionId     String              @map("execution_id")
  targetComponent String              @map("target_component")
  status          TransferBatchStatus @default(PENDING_REVIEW)
  totalItems      Int                 @default(0) @map("total_items")
  heldItems       Int                 @default(0) @map("held_items")
  rejectedItems   Int                 @default(0) @map("rejected_items")
  committedItems  Int                 @default(0) @map("committed_items")
  errorItems      Int                 @default(0) @map("error_items")
  /// SHA-256 of the mapped source records that produced this batch.
  /// Import idempotency: re-uploading the same file after a timeout used to
  /// stage a second batch and post the revenue twice. The unique constraint
  /// below makes that impossible. Nullable for batches staged before this
  /// existed — Postgres treats NULLs as distinct, so they never collide.
  sourceHash      String?             @map("source_hash")
  createdById     String              @map("created_by")
  createdAt       DateTime            @default(now()) @map("created_at")
  reviewedById    String?             @map("reviewed_by")
  committedAt     DateTime?           @map("committed_at")

  items TransferBatchItem[]

  @@unique([entityId, profileId, sourceHash])
  @@index([entityId, status])
  @@index([profileId])
  @@map("transfer_batches")
}

// ── TD-DB-020: transfer_batch_items ──────────────────────────────────────────

model TransferBatchItem {
  id                  String                   @id @default(uuid())
  batchId             String                   @map("batch_id")
  itemIndex           Int                      @map("item_index")
  status              TransferBatchItemStatus  @default(HELD)
  targetComponent     String                   @map("target_component")
  payload             Json
  sourceRecordIndices Int[]                    @map("source_record_indices")
  validationStatus    TransferValidationStatus @default(OK) @map("validation_status")
  validationMessages  Json?                    @map("validation_messages")
  resultJournalId     String?                  @map("result_journal_id")
  rejectedReason      String?                  @map("rejected_reason")
  createdAt           DateTime                 @default(now()) @map("created_at")

  batch TransferBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, status])
  @@map("transfer_batch_items")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Ledger Setup (spec Module 1.2.1 — per BU/ledger posting configuration)
// ═══════════════════════════════════════════════════════════════════════════════

model LedgerSetup {
  id                            String             @id @default(uuid())
  entityId                      String             @map("entity_id")
  /// Ledger identifier A–K (default "A" = primary financials ledger)
  ledger                        String             @default("A") @db.Char(1)
  /// Open posting date range start (absolute YYYY-MM-DD, relative +/-nnn, or "T" for today)
  openDateFrom                  String?            @map("open_date_from") @db.VarChar(12)
  /// Open posting date range end
  openDateTo                    String?            @map("open_date_to") @db.VarChar(12)
  provisionalPosting            ProvisionalPosting @default(OPTIONAL) @map("provisional_posting")
  useFinancialCalendar          Boolean            @default(false) @map("use_financial_calendar")
  baseCurrency                  String             @default("USD") @map("base_currency") @db.VarChar(3)
  secondBaseCurrency            String?            @map("second_base_currency") @db.VarChar(3)
  fourthCurrencyCode            String?            @map("fourth_currency_code") @db.VarChar(3)
  roundingMethod                RoundingMethod     @default(NORMAL) @map("rounding_method")
  roundingUnit                  String?            @map("rounding_unit") @db.VarChar(20)
  paymentRunEnabled             Boolean            @default(false) @map("payment_run_enabled")
  payAtCurrentRates             Boolean            @default(true) @map("pay_at_current_rates")
  nonMatchSystemPayments        Boolean            @default(false) @map("non_match_system_payments")
  /// Tracks the current open period for this BU/ledger
  currentPeriodId               String?            @map("current_period_id")
  /// Prevent retrospective depreciation recalculation once a period is closed
  lockCalculatedDepreciation    Boolean            @default(false) @map("lock_calculated_depreciation")
  /// Full year depreciation in the acquisition year (no proration)
  fullYearDepreciationFirstYear Boolean            @default(false) @map("full_year_depreciation_first_year")
  /// Subtract residual/final value before calculating depreciation
  excludeFinalValueFromDepn     Boolean            @default(true) @map("exclude_final_value_from_depn")
  /// Require multi-stage authorization for journal posting (global default, overridden by JournalType)
  authorizationRequired         Boolean            @default(false) @map("authorization_required")
  createdAt                     DateTime           @default(now()) @map("created_at")
  updatedAt                     DateTime           @updatedAt @map("updated_at")

  entity        Entity  @relation(fields: [entityId], references: [id])
  currentPeriod Period? @relation(fields: [currentPeriodId], references: [id])

  @@unique([entityId, ledger])
  @@map("ledger_setups")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Process Locks (spec Module 10 — exclusive locking for period-end processes)
// ═══════════════════════════════════════════════════════════════════════════════

model ProcessLock {
  id           String    @id @default(uuid())
  entityId     String    @map("entity_id")
  /// Process type: PERIOD_CLOSE, PERIOD_REOPEN, REVALUATION, DEPRECIATION, ALLOCATION, PAYMENT_RUN, etc.
  processType  String    @map("process_type") @db.VarChar(50)
  /// Ledger identifier (default "A")
  ledger       String    @default("A") @db.Char(1)
  acquiredAt   DateTime  @default(now()) @map("acquired_at")
  /// Lock expires after this time (prevents permanent deadlocks from crashes)
  expiresAt    DateTime  @map("expires_at")
  releasedAt   DateTime? @map("released_at")
  /// User who acquired the lock (NULL for system/worker processes)
  acquiredById String?   @map("acquired_by")
  /// BullMQ worker instance ID (for cleanup)
  workerId     String?   @map("worker_id") @db.VarChar(100)
  isActive     Boolean   @default(true) @map("is_active")

  entity     Entity @relation(fields: [entityId], references: [id])
  acquiredBy User?  @relation(fields: [acquiredById], references: [id])

  @@index([entityId, processType, ledger, isActive])
  @@map("process_locks")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Period Close Status (spec Module 10 — tracks period-end process completion)
// ═══════════════════════════════════════════════════════════════════════════════

model PeriodCloseStatus {
  id               String           @id @default(uuid())
  entityId         String           @map("entity_id")
  periodId         String           @map("period_id")
  ledger           String           @default("A") @db.Char(1)
  status           PeriodCloseState @default(PC_OPEN)
  revaluationRun   Boolean          @default(false) @map("revaluation_run")
  depreciationRun  Boolean          @default(false) @map("depreciation_run")
  allocationsRun   Boolean          @default(false) @map("allocations_run")
  yearEndProcessed Boolean          @default(false) @map("year_end_processed")
  closedById       String?          @map("closed_by")
  closedAt         DateTime?        @map("closed_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  entity   Entity @relation(fields: [entityId], references: [id])
  period   Period @relation(fields: [periodId], references: [id])
  closedBy User?  @relation(fields: [closedById], references: [id])

  @@unique([entityId, periodId, ledger])
  @@map("period_close_statuses")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Analysis Dimensions (spec Module 2.2.2 — T1–T10 dimension definitions)
// ═══════════════════════════════════════════════════════════════════════════════

model AnalysisDimension {
  id              String                  @id @default(uuid())
  entityId        String                  @map("entity_id")
  /// Dimension number 1–10 (maps to T1–T10 / dimension1–dimension10)
  dimensionNumber Int                     @map("dimension_number")
  dimensionName   String                  @map("dimension_name") @db.VarChar(50)
  isRequired      Boolean                 @default(false) @map("is_required")
  validationType  DimensionValidationType @default(NONE) @map("validation_type")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  entity Entity         @relation(fields: [entityId], references: [id])
  codes  AnalysisCode[]

  @@unique([entityId, dimensionNumber])
  @@map("analysis_dimensions")
}

model AnalysisCode {
  id          String  @id @default(uuid())
  dimensionId String  @map("dimension_id")
  code        String  @db.VarChar(30)
  description String? @db.VarChar(100)
  isActive    Boolean @default(true) @map("is_active")

  dimension AnalysisDimension @relation(fields: [dimensionId], references: [id], onDelete: Cascade)

  @@unique([dimensionId, code])
  @@map("analysis_codes")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Corporate Allocations (spec Module 6 — Ch. 7)
// ═══════════════════════════════════════════════════════════════════════════════

model AllocationDefinition {
  id                String         @id @default(uuid())
  entityId          String         @map("entity_id")
  name              String         @db.VarChar(100)
  description       String?        @db.VarChar(500)
  allocationType    AllocationType @map("allocation_type")
  /// Optional: lock allocation to a specific period. Null = uses current period at run time.
  periodId          String?        @map("period_id")
  /// When true, this definition participates in a stepped sequence (run in sequenceOrder).
  isSteppedSequence Boolean        @default(false) @map("is_stepped_sequence")
  sequenceOrder     Int            @default(0) @map("sequence_order")
  isActive          Boolean        @default(true) @map("is_active")
  /// System-shipped definitions are read-only (clonable but not deletable).
  isSystem          Boolean        @default(false) @map("is_system")
  createdById       String?        @map("created_by")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  entity    Entity             @relation(fields: [entityId], references: [id])
  period    Period?            @relation(fields: [periodId], references: [id])
  createdBy User?              @relation("AllocationCreatedBy", fields: [createdById], references: [id])
  sources   AllocationSource[]
  targets   AllocationTarget[]

  @@unique([entityId, name])
  @@index([entityId, isActive])
  @@index([entityId, isSteppedSequence, sequenceOrder])
  @@map("allocation_definitions")
}

model AllocationSource {
  id               String                @id @default(uuid())
  definitionId     String                @map("definition_id")
  /// Account code range start (inclusive)
  accountCodeFrom  String                @map("account_code_from") @db.VarChar(50)
  /// Account code range end (inclusive). Same as accountCodeFrom for single account.
  accountCodeTo    String                @map("account_code_to") @db.VarChar(50)
  /// Optional analysis code filters (up to 3 dimensions)
  analysisCode1    String?               @map("analysis_code_1") @db.VarChar(50)
  analysisCode2    String?               @map("analysis_code_2") @db.VarChar(50)
  analysisCode3    String?               @map("analysis_code_3") @db.VarChar(50)
  /// Which balance to read: OPENING, MOVEMENTS, or CLOSING
  balanceType      AllocationBalanceType @default(MOVEMENTS) @map("balance_type")
  /// Skip source if absolute amount below this threshold
  minimumThreshold Decimal?              @map("minimum_threshold") @db.Decimal(18, 4)
  /// Cap source amount at this maximum
  maximumThreshold Decimal?              @map("maximum_threshold") @db.Decimal(18, 4)
  /// Ordering for multi-source definitions (processed sequentially)
  sourceOrder      Int                   @default(0) @map("source_order")

  definition AllocationDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@index([definitionId])
  @@map("allocation_sources")
}

model AllocationTarget {
  id                   String              @id @default(uuid())
  definitionId         String              @map("definition_id")
  /// Account to post the allocated amount to
  targetAccountCode    String              @map("target_account_code") @db.VarChar(50)
  /// Offset account for CHARGE type (contra entry). Null for SPLIT (uses source account).
  offsetAccountCode    String?             @map("offset_account_code") @db.VarChar(50)
  /// How the allocation amount is determined for this target
  basisType            AllocationBasisType @map("basis_type")
  /// For FIXED_PERCENTAGE: the percentage (0–100) allocated to this target
  fixedPercentage      Decimal?            @map("fixed_percentage") @db.Decimal(8, 4)
  /// For FIXED_AMOUNT: the absolute amount allocated to this target
  fixedAmount          Decimal?            @map("fixed_amount") @db.Decimal(18, 4)
  /// For ACCOUNT_BALANCE: ratio account range start
  ratioAccountCodeFrom String?             @map("ratio_account_code_from") @db.VarChar(50)
  /// For ACCOUNT_BALANCE: ratio account range end
  ratioAccountCodeTo   String?             @map("ratio_account_code_to") @db.VarChar(50)
  /// For STATISTICAL_KEY: the statistical key identifier
  statisticalKey       String?             @map("statistical_key") @db.VarChar(50)
  /// For STATISTICAL_KEY: the statistical value for this target
  statisticalValue     Decimal?            @map("statistical_value") @db.Decimal(18, 4)
  /// Free-form analysis code assignments for the generated journal lines (JSON object)
  analysisCodes        Json?               @map("analysis_codes")
  /// Ordering for multi-target definitions
  targetOrder          Int                 @default(0) @map("target_order")

  definition AllocationDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@index([definitionId])
  @@map("allocation_targets")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Fixed Asset Register (spec Module 9 — Ch. 12)
// ═══════════════════════════════════════════════════════════════════════════════

model AssetCategory {
  id                        String              @id @default(uuid())
  entityId                  String              @map("entity_id")
  code                      String              @db.VarChar(30)
  name                      String              @db.VarChar(100)
  /// Default useful life for new assets in this category
  defaultUsefulLifeMonths   Int?                @map("default_useful_life_months")
  defaultDepreciationMethod DepreciationMethod? @map("default_depreciation_method")
  /// Default BS accumulated depreciation account code
  defaultBsDepreciationAcct String?             @map("default_bs_depreciation_acct") @db.VarChar(50)
  /// Default P&L depreciation expense account code
  defaultPlDepreciationAcct String?             @map("default_pl_depreciation_acct") @db.VarChar(50)
  isActive                  Boolean             @default(true) @map("is_active")
  sortOrder                 Int                 @default(0) @map("sort_order")
  createdAt                 DateTime            @default(now()) @map("created_at")
  updatedAt                 DateTime            @updatedAt @map("updated_at")

  entity Entity       @relation(fields: [entityId], references: [id])
  assets FixedAsset[]

  @@unique([entityId, code])
  @@map("asset_categories")
}

model FixedAsset {
  id                        String             @id @default(uuid())
  entityId                  String             @map("entity_id")
  /// Unique asset tag / code within entity (e.g. "FA-00142")
  assetCode                 String             @map("asset_code") @db.VarChar(30)
  /// Alternative lookup code
  lookupCode                String?            @map("lookup_code") @db.VarChar(30)
  description               String             @db.VarChar(255)
  categoryId                String?            @map("category_id")
  /// Balance sheet accumulated depreciation account code
  bsDepreciationAccount     String             @map("bs_depreciation_account") @db.VarChar(50)
  /// P&L depreciation expense account code
  plDepreciationAccount     String             @map("pl_depreciation_account") @db.VarChar(50)
  depreciationMethod        DepreciationMethod @default(STRAIGHT_LINE) @map("depreciation_method")
  /// Annual depreciation rate as percentage (e.g. 20.00 = 20%)
  depreciationRate          Decimal?           @map("depreciation_rate") @db.Decimal(8, 4)
  /// Useful life in months
  usefulLifeMonths          Int                @map("useful_life_months")
  /// Period in which depreciation begins
  depreciationStartPeriodId String?            @map("depreciation_start_period_id")
  /// Days of depreciation in the first period (proration)
  firstPeriodDays           Int?               @map("first_period_days")
  /// Residual / salvage value
  finalValue                Decimal            @default(0) @map("final_value") @db.Decimal(18, 4)
  /// Acquisition cost (base currency)
  grossValue                Decimal            @default(0) @map("gross_value") @db.Decimal(18, 4)
  /// Total depreciation charged to date
  accumulatedDepreciation   Decimal            @default(0) @map("accumulated_depreciation") @db.Decimal(18, 4)
  /// Current net book value = grossValue − accumulatedDepreciation
  netValue                  Decimal            @default(0) @map("net_value") @db.Decimal(18, 4)
  /// Number of physical units (e.g. 100 chairs as one asset line)
  assetQuantity             Decimal?           @map("asset_quantity") @db.Decimal(18, 4)
  acquisitionDate           DateTime           @map("acquisition_date") @db.Date
  disposalDate              DateTime?          @map("disposal_date") @db.Date
  status                    AssetStatus        @default(ACTIVE)
  /// Analysis dimensions: T1=Property, T2=Department, T3=Category, T4=Location, T5=Supplier
  analysisCode1             String?            @map("analysis_code_1") @db.VarChar(50)
  analysisCode2             String?            @map("analysis_code_2") @db.VarChar(50)
  analysisCode3             String?            @map("analysis_code_3") @db.VarChar(50)
  analysisCode4             String?            @map("analysis_code_4") @db.VarChar(50)
  analysisCode5             String?            @map("analysis_code_5") @db.VarChar(50)
  createdById               String?            @map("created_by")
  createdAt                 DateTime           @default(now()) @map("created_at")
  updatedAt                 DateTime           @updatedAt @map("updated_at")

  entity                  Entity         @relation(fields: [entityId], references: [id])
  category                AssetCategory? @relation(fields: [categoryId], references: [id])
  createdBy               User?          @relation("AssetCreatedBy", fields: [createdById], references: [id])
  depreciationStartPeriod Period?        @relation(fields: [depreciationStartPeriodId], references: [id])

  @@unique([entityId, assetCode])
  @@index([entityId, status])
  @@index([entityId, categoryId])
  @@map("fixed_assets")
}

model DepreciationTable {
  id       String  @id @default(uuid())
  entityId String  @map("entity_id")
  code     String  @db.VarChar(20)
  name     String  @db.VarChar(100)
  /// Array of { period: number, rate: number } defining the depreciation curve
  entries  Json    @default("[]")
  isActive Boolean @default(true) @map("is_active")

  entity Entity @relation(fields: [entityId], references: [id])

  @@unique([entityId, code])
  @@map("depreciation_tables")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Multi-stage Authorization Workflow (spec Module 4 — Authorization Facility)
// ═══════════════════════════════════════════════════════════════════════════════

model AuthorizationStage {
  id                 String             @id @default(uuid())
  entityId           String             @map("entity_id")
  /// Unique stage code within entity (e.g. "STAGE-1", "FINAL")
  stageCode          String             @map("stage_code") @db.VarChar(20)
  stageName          String             @map("stage_name") @db.VarChar(100)
  /// Sequence order — stage 1 must approve before stage 2 sees the transaction
  stageOrder         Int                @map("stage_order")
  /// Number of approvals from the team needed to advance this stage (default 1 = any member)
  requiredApprovers  Int                @default(1) @map("required_approvers")
  /// Automatically advance to next stage after required approvals met
  autoAdvance        Boolean            @default(true) @map("auto_advance")
  /// Where a rejection returns the transaction to
  rejectionReturnsTo RejectionReturnsTo @default(ORIGINATOR) @map("rejection_returns_to")
  /// If rejectionReturnsTo = SPECIFIC_STAGE, which stage to return to
  returnToStageId    String?            @map("return_to_stage_id")
  /// Optional: only applies to this journal type (null = global for entity)
  journalTypeId      String?            @map("journal_type_id")
  /// Optional: only applies when journal amount >= this threshold
  amountThreshold    Decimal?           @map("amount_threshold") @db.Decimal(18, 4)
  /// Which team can approve at this stage
  userTeamId         String             @map("user_team_id")
  isActive           Boolean            @default(true) @map("is_active")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  entity                Entity                 @relation(fields: [entityId], references: [id])
  journalType           JournalType?           @relation(fields: [journalTypeId], references: [id])
  userTeam              AuthorizationTeam      @relation(fields: [userTeamId], references: [id])
  returnToStage         AuthorizationStage?    @relation("StageReturnTo", fields: [returnToStageId], references: [id])
  stagesReturningHere   AuthorizationStage[]   @relation("StageReturnTo")
  journalAuthorizations JournalAuthorization[]

  @@unique([entityId, stageCode])
  @@index([entityId, journalTypeId, stageOrder])
  @@map("authorization_stages")
}

model AuthorizationTeam {
  id        String   @id @default(uuid())
  entityId  String   @map("entity_id")
  code      String   @db.VarChar(20)
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  entity      Entity                    @relation(fields: [entityId], references: [id])
  members     AuthorizationTeamMember[]
  stages      AuthorizationStage[]
  delegations AuthorizationDelegation[]

  @@unique([entityId, code])
  @@map("authorization_teams")
}

model AuthorizationTeamMember {
  id     String @id @default(uuid())
  teamId String @map("team_id")
  userId String @map("user_id")

  team AuthorizationTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User              @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@map("authorization_team_members")
}

model AuthorizationDelegation {
  id          String   @id @default(uuid())
  entityId    String   @map("entity_id")
  /// User granting their authority
  delegatorId String   @map("delegator_id")
  /// User receiving delegated authority
  delegateId  String   @map("delegate_id")
  /// Team scope for the delegation
  teamId      String   @map("team_id")
  validFrom   DateTime @map("valid_from") @db.Date
  validTo     DateTime @map("valid_to") @db.Date
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  entity    Entity            @relation(fields: [entityId], references: [id])
  delegator User              @relation("DelegationFrom", fields: [delegatorId], references: [id])
  delegate  User              @relation("DelegationTo", fields: [delegateId], references: [id])
  team      AuthorizationTeam @relation(fields: [teamId], references: [id])

  @@index([entityId, delegateId, isActive])
  @@map("authorization_delegations")
}

model RejectionCode {
  id          String   @id @default(uuid())
  entityId    String   @map("entity_id")
  code        String   @db.VarChar(20)
  description String   @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  entity                Entity                 @relation(fields: [entityId], references: [id])
  journalAuthorizations JournalAuthorization[]

  @@unique([entityId, code])
  @@map("rejection_codes")
}

model AuthorizationSet {
  id          String                 @id @default(uuid())
  entityId    String                 @map("entity_id")
  name        String                 @db.VarChar(200)
  status      AuthorizationSetStatus @default(OPEN)
  createdById String                 @map("created_by")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  entity    Entity    @relation(fields: [entityId], references: [id])
  createdBy User      @relation("AuthSetCreatedBy", fields: [createdById], references: [id])
  journals  Journal[]

  @@index([entityId, status])
  @@map("authorization_sets")
}

model JournalAuthorization {
  id              String                      @id @default(uuid())
  entityId        String                      @map("entity_id")
  journalId       String                      @map("journal_id")
  stageId         String                      @map("stage_id")
  /// Denormalized stage order for efficient query
  stageOrder      Int                         @map("stage_order")
  status          AuthorizationDecisionStatus @default(PENDING)
  decidedById     String?                     @map("decided_by")
  rejectionCodeId String?                     @map("rejection_code_id")
  comments        String?
  decidedAt       DateTime?                   @map("decided_at")
  createdAt       DateTime                    @default(now()) @map("created_at")

  entity        Entity             @relation(fields: [entityId], references: [id])
  journal       Journal            @relation(fields: [journalId], references: [id])
  stage         AuthorizationStage @relation(fields: [stageId], references: [id])
  decidedBy     User?              @relation("AuthDecidedBy", fields: [decidedById], references: [id])
  rejectionCode RejectionCode?     @relation(fields: [rejectionCodeId], references: [id])

  @@unique([journalId, stageId])
  @@index([entityId, journalId, stageOrder])
  @@index([entityId, status])
  @@map("journal_authorizations")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Payment Profiles (spec Module 4 — PYP configurable payment/collection runs)
// ═══════════════════════════════════════════════════════════════════════════════

enum PaymentProfileDirection {
  PAY // AP — outgoing payments to suppliers
  COLLECT // AR — incoming collections from customers (direct debit)
}

enum FXHandling {
  ORIGINAL // Pay at original transaction FX rate
  CURRENT_RATE // Pay at current (latest) FX rate
}

model PaymentProfile {
  id                String                  @id @default(uuid())
  entityId          String                  @map("entity_id")
  name              String                  @db.VarChar(200)
  direction         PaymentProfileDirection
  paymentMethod     PaymentMethod           @map("payment_method")
  bankAccountId     String?                 @map("bank_account_id")
  currency          String?                 @db.Char(3)
  fxHandling        FXHandling              @default(ORIGINAL) @map("fx_handling")
  /// Selection criteria: { supplierIds?, customerIds?, amountMin?, amountMax?, dueDateFrom?, dueDateTo?, accountTypes? }
  selectionCriteria Json                    @default("{}") @map("selection_criteria")
  /// Grouping rules: { consolidatePerSupplier: bool, consolidatePerCustomer: bool }
  groupingRules     Json                    @default("{}") @map("grouping_rules")
  /// Maximum total payment/collection amount per run
  totalPaymentLimit Decimal?                @map("total_payment_limit") @db.Decimal(18, 4)
  remittanceAdvice  Boolean                 @default(true) @map("remittance_advice")
  isActive          Boolean                 @default(true) @map("is_active")
  isSystem          Boolean                 @default(false) @map("is_system")
  description       String?                 @db.VarChar(500)
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  entity      Entity       @relation(fields: [entityId], references: [id])
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])
  paymentRuns PaymentRun[]

  @@index([entityId, direction, isActive])
  @@index([bankAccountId])
  @@map("payment_profiles")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Revaluation Profiles (spec Module 8 — LER ledger revaluation configuration)
// ═══════════════════════════════════════════════════════════════════════════════

enum RevaluationRateType {
  CLOSING
  AVERAGE
  CUSTOM
}

model RevaluationProfile {
  id                String               @id @default(uuid())
  entityId          String               @map("entity_id")
  name              String               @db.VarChar(200)
  /// Account type filter: ["ASSET","LIABILITY","EQUITY","REVENUE","EXPENSE"] or subset
  accountTypeFilter Json                 @default("[]") @map("account_type_filter")
  accountCodeFrom   String?              @map("account_code_from") @db.VarChar(15)
  accountCodeTo     String?              @map("account_code_to") @db.VarChar(15)
  /// Specific currency to revalue (NULL = all non-functional currencies)
  currencyFilter    String?              @map("currency_filter") @db.Char(3)
  rateType          RevaluationRateType  @default(CLOSING) @map("rate_type")
  /// Account code for posting unrealized FX gains
  gainAccountCode   String               @map("gain_account_code") @db.VarChar(15)
  /// Account code for posting unrealized FX losses
  lossAccountCode   String               @map("loss_account_code") @db.VarChar(15)
  /// Auto-reverse the revaluation journal in the next period (standard IAS 21 practice)
  autoReverse       Boolean              @default(true) @map("auto_reverse")
  /// Whether to post revaluation entries or just produce a report
  postDifferences   Boolean              @default(true) @map("post_differences")
  isActive          Boolean              @default(true) @map("is_active")
  description       String?              @db.VarChar(500)
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  entity Entity @relation(fields: [entityId], references: [id])

  @@index([entityId, isActive])
  @@map("revaluation_profiles")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Year-End Configuration (spec Module 10 — Year-End Cleardown)
// ═══════════════════════════════════════════════════════════════════════════════

model YearEndConfig {
  id                      String   @id @default(uuid())
  entityId                String   @map("entity_id")
  /// Account code of the Retained Earnings / Accumulated P&L account
  retainedEarningsCode    String   @map("retained_earnings_code") @db.VarChar(15)
  /// Optional: journal type to use for the year-end journal
  journalTypeCode         String?  @map("journal_type_code") @db.VarChar(20)
  /// Fiscal year start month (1-12). Default 1 = January fiscal year.
  fiscalYearStartMonth    Int      @default(1) @map("fiscal_year_start_month")
  description             String?  @db.VarChar(500)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  entity Entity @relation(fields: [entityId], references: [id])

  @@unique([entityId])
  @@map("year_end_configs")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Intercompany Journals (spec Module 3 — Cross-Entity Postings)
// ═══════════════════════════════════════════════════════════════════════════════

enum IntercompanyJournalStatus {
  PENDING_SOURCE_APPROVAL
  PENDING_MIRROR_APPROVAL
  PENDING_BOTH_APPROVAL
  APPROVED
  POSTED
  REJECTED
}

model IntercompanyAccountPair {
  id                     String   @id @default(uuid())
  entityId               String   @map("entity_id")
  counterpartyEntityId   String   @map("counterparty_entity_id")
  /// IC Receivable account code in this entity
  icReceivableCode       String   @map("ic_receivable_code") @db.VarChar(15)
  /// IC Payable account code in this entity
  icPayableCode          String   @map("ic_payable_code") @db.VarChar(15)
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  entity             Entity @relation("ICPairOwner", fields: [entityId], references: [id])
  counterpartyEntity Entity @relation("ICPairCounterparty", fields: [counterpartyEntityId], references: [id])

  @@unique([entityId, counterpartyEntityId])
  @@map("intercompany_account_pairs")
}

model IntercompanyJournal {
  id                   String                      @id @default(uuid())
  /// Entity that initiated the IC transaction
  sourceEntityId       String                      @map("source_entity_id")
  /// Counterparty entity receiving the mirror entry
  mirrorEntityId       String                      @map("mirror_entity_id")
  /// Journal in the source entity
  sourceJournalId      String?                     @map("source_journal_id")
  /// Mirror journal in the counterparty entity
  mirrorJournalId      String?                     @map("mirror_journal_id")
  status               IntercompanyJournalStatus   @default(PENDING_BOTH_APPROVAL)
  /// Amount in functional currency of the source entity
  amount               Decimal                     @db.Decimal(18, 4)
  currency             String                      @db.VarChar(3)
  reference            String                      @db.VarChar(60)
  description          String?                     @db.VarChar(500)
  sourceApprovedById   String?                     @map("source_approved_by")
  sourceApprovedAt     DateTime?                   @map("source_approved_at")
  mirrorApprovedById   String?                     @map("mirror_approved_by")
  mirrorApprovedAt     DateTime?                   @map("mirror_approved_at")
  rejectedById         String?                     @map("rejected_by")
  rejectedAt           DateTime?                   @map("rejected_at")
  rejectionReason      String?                     @map("rejection_reason") @db.VarChar(500)
  createdById          String                      @map("created_by")
  createdAt            DateTime                    @default(now()) @map("created_at")
  updatedAt            DateTime                    @updatedAt @map("updated_at")

  sourceEntity  Entity   @relation("ICJournalSource", fields: [sourceEntityId], references: [id])
  mirrorEntity  Entity   @relation("ICJournalMirror", fields: [mirrorEntityId], references: [id])
  sourceJournal Journal? @relation("ICSourceJournal", fields: [sourceJournalId], references: [id])
  mirrorJournal Journal? @relation("ICMirrorJournal", fields: [mirrorJournalId], references: [id])

  @@index([sourceEntityId, status])
  @@index([mirrorEntityId, status])
  @@map("intercompany_journals")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Intercompany v2 — Entity Pairs, Account Mappings, Transactions, Reconciliation
// ═══════════════════════════════════════════════════════════════════════════════

enum ICTransactionStatus {
  DRAFT
  PENDING_APPROVAL
  POSTED
  REJECTED
  REVERSED
}

model ICEntityPair {
  id                   String   @id @default(uuid())
  entityAId            String   @map("entity_a_id")
  entityBId            String   @map("entity_b_id")
  isActive             Boolean  @default(true) @map("is_active")
  autoApproveThreshold Decimal? @map("auto_approve_threshold") @db.Decimal(18, 4)
  description          String?  @db.VarChar(500)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  entityA  Entity @relation("ICPairEntityA", fields: [entityAId], references: [id])
  entityB  Entity @relation("ICPairEntityB", fields: [entityBId], references: [id])

  accountMappings ICAccountMapping[]
  transactions    ICTransaction[]

  @@unique([entityAId, entityBId])
  @@map("ic_entity_pairs")
}

model ICAccountMapping {
  id              String   @id @default(uuid())
  pairId          String   @map("pair_id")
  name            String   @db.VarChar(100)
  /// Account code in Entity A to debit
  entityADebitCode  String  @map("entity_a_debit_code") @db.VarChar(15)
  /// Account code in Entity A to credit
  entityACreditCode String  @map("entity_a_credit_code") @db.VarChar(15)
  /// Account code in Entity B to debit
  entityBDebitCode  String  @map("entity_b_debit_code") @db.VarChar(15)
  /// Account code in Entity B to credit
  entityBCreditCode String  @map("entity_b_credit_code") @db.VarChar(15)
  isActive          Boolean @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  pair         ICEntityPair    @relation(fields: [pairId], references: [id])
  transactions ICTransaction[]

  @@map("ic_account_mappings")
}

model ICTransaction {
  id                String              @id @default(uuid())
  pairId            String              @map("pair_id")
  mappingId         String?             @map("mapping_id")
  /// Entity that initiated the transaction
  initiatingEntityId String             @map("initiating_entity_id")
  /// Counterparty entity
  counterpartyEntityId String           @map("counterparty_entity_id")
  status            ICTransactionStatus @default(DRAFT)
  /// Transaction amount in the stated currency
  amount            Decimal             @db.Decimal(18, 4)
  currency          String              @db.VarChar(3)
  /// FX rate from transaction currency to initiating entity functional currency
  fxRateInitiator   Decimal             @default(1) @map("fx_rate_initiator") @db.Decimal(18, 8)
  /// FX rate from transaction currency to counterparty functional currency
  fxRateCounterparty Decimal            @default(1) @map("fx_rate_counterparty") @db.Decimal(18, 8)
  /// Functional amount in initiating entity's currency
  functionalAmountInitiator Decimal     @map("functional_amount_initiator") @db.Decimal(18, 4)
  /// Functional amount in counterparty entity's currency
  functionalAmountCounterparty Decimal  @map("functional_amount_counterparty") @db.Decimal(18, 4)
  reference         String              @db.VarChar(60)
  description       String?             @db.VarChar(500)
  periodId          String              @map("period_id")
  /// Journal posted in initiating entity
  initiatorJournalId String?            @map("initiator_journal_id")
  /// Journal posted in counterparty entity
  counterpartyJournalId String?         @map("counterparty_journal_id")
  /// If this is a reversal, the original transaction ID
  reversalOfId      String?             @map("reversal_of_id")
  createdById       String              @map("created_by")
  approvedById      String?             @map("approved_by")
  approvedAt        DateTime?           @map("approved_at")
  rejectedById      String?             @map("rejected_by")
  rejectedAt        DateTime?           @map("rejected_at")
  rejectionReason   String?             @map("rejection_reason") @db.VarChar(500)
  postedAt          DateTime?           @map("posted_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  pair               ICEntityPair     @relation(fields: [pairId], references: [id])
  mapping            ICAccountMapping? @relation(fields: [mappingId], references: [id])
  initiatingEntity   Entity           @relation("ICTxnInitiator", fields: [initiatingEntityId], references: [id])
  counterpartyEntity Entity           @relation("ICTxnCounterparty", fields: [counterpartyEntityId], references: [id])
  initiatorJournal   Journal?         @relation("ICTxnInitiatorJournal", fields: [initiatorJournalId], references: [id])
  counterpartyJournal Journal?        @relation("ICTxnCounterpartyJournal", fields: [counterpartyJournalId], references: [id])
  reversalOf         ICTransaction?   @relation("ICTxnReversal", fields: [reversalOfId], references: [id])
  reversals          ICTransaction[]  @relation("ICTxnReversal")

  @@index([pairId, status])
  @@index([initiatingEntityId, status])
  @@index([counterpartyEntityId, status])
  @@map("ic_transactions")
}

model ICReconciliationSnapshot {
  id              String   @id @default(uuid())
  pairId          String   @map("pair_id")
  periodId        String   @map("period_id")
  /// Balance as seen by Entity A (positive = A owes B)
  balanceEntityA  Decimal  @map("balance_entity_a") @db.Decimal(18, 4)
  /// Balance as seen by Entity B (positive = B owes A)
  balanceEntityB  Decimal  @map("balance_entity_b") @db.Decimal(18, 4)
  /// Difference between the two views
  difference      Decimal  @db.Decimal(18, 4)
  currency        String   @db.VarChar(3)
  status          String   @default("UNRECONCILED") @db.VarChar(20)
  notes           String?  @db.VarChar(500)
  createdById     String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([pairId, periodId])
  @@map("ic_reconciliation_snapshots")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Bank Accounts (master table for entity bank accounts)
// ═══════════════════════════════════════════════════════════════════════════════

model BankAccount {
  id            String   @id @default(uuid())
  entityId      String   @map("entity_id")
  /// Reference to the GL cash/bank account in the chart of accounts
  glAccountId   String?  @map("gl_account_id")
  bankName      String   @map("bank_name") @db.VarChar(200)
  accountName   String?  @map("account_name") @db.VarChar(200)
  accountNumber String   @map("account_number") @db.VarChar(50)
  currency      String   @db.Char(3)
  swiftCode     String?  @map("swift_code") @db.VarChar(11)
  iban          String?  @db.VarChar(34)
  branchCode    String?  @map("branch_code") @db.VarChar(20)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  entity      Entity     @relation(fields: [entityId], references: [id])
  glAccount   Account?   @relation(fields: [glAccountId], references: [id])
  apPayments  APPayment[]
  arReceipts  ARReceipt[]
  paymentProfiles PaymentProfile[]

  @@unique([entityId, accountNumber])
  @@index([entityId, isActive])
  @@map("bank_accounts")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Tax Codes & Rates (VAT / WHT / Sales Tax compliance)
// ═══════════════════════════════════════════════════════════════════════════════

enum TaxType {
  VAT
  WHT
  SALES_TAX
  EXCISE
}

model TaxCode {
  id          String   @id @default(uuid())
  entityId    String   @map("entity_id")
  code        String   @db.VarChar(20)
  description String?  @db.VarChar(200)
  taxType     TaxType  @map("tax_type")
  isActive    Boolean  @default(true) @map("is_active")
  /// GL account debited for input (recoverable) tax when an AP invoice is
  /// posted. Normally a receivable-from-revenue-authority asset account.
  /// Required before an AP invoice carrying tax under this code can post —
  /// there is no safe default, so posting fails loudly rather than silently
  /// dropping the tax the way it used to.
  inputTaxAccountId  String? @map("input_tax_account_id")
  /// GL account credited for output tax when an AR invoice is posted.
  /// Normally a payable-to-revenue-authority liability account.
  outputTaxAccountId String? @map("output_tax_account_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  entity           Entity          @relation(fields: [entityId], references: [id])
  rates            TaxRate[]
  apInvoiceLines   APInvoiceLine[]
  arInvoices       ARInvoice[]
  inputTaxAccount  Account?        @relation("TaxCodeInputAccount", fields: [inputTaxAccountId], references: [id])
  outputTaxAccount Account?        @relation("TaxCodeOutputAccount", fields: [outputTaxAccountId], references: [id])

  @@unique([entityId, code])
  @@index([entityId, taxType, isActive])
  @@map("tax_codes")
}

model TaxRate {
  id            String    @id @default(uuid())
  taxCodeId     String    @map("tax_code_id")
  rate          Decimal   @db.Decimal(8, 4)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  isCurrent     Boolean   @default(true) @map("is_current")
  createdAt     DateTime  @default(now()) @map("created_at")

  taxCode TaxCode @relation(fields: [taxCodeId], references: [id], onDelete: Cascade)

  @@index([taxCodeId, isCurrent])
  @@map("tax_rates")
}
