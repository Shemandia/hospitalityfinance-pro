{
  "name": "@hfp/posting-contract",
  "version": "0.1.0",
  "private": true,
  "description": "HFP Integrations: the canonical documents every import produces and the posting service accepts (docs/IMPORT-PLAN.md section 2). Versioned Zod schemas.",
