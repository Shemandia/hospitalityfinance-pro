generator client {
  provider = "prisma-client-js"
  output   = "./generated/tenant"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum EntityType {
  CORPORATE // Top-level corporate entity (HQ)
  GROUP // Legacy alias for CORPORATE (backwards compat)
  CLUSTER // Regional cluster (e.g. Middle East, Europe)
  PROPERTY // Individual hotel/resort
}

enum EntityRole {
  ADMIN
  CONTROLLER
  VIEWER
  SUPERADMIN
}

enum AccountTypeCategory {
  BALANCE_SHEET
  INCOME
  STATISTICAL
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum PeriodStatus {
  OPEN
  SOFT_CLOSE // Intermediate: revaluation/depreciation/allocation may still run
  CLOSED
  LOCKED
}

// ── Ledger Setup enums ───────────────────────────────────────────────────────

enum ProvisionalPosting {
  MANDATORY
  OPTIONAL
  PROHIBITED
}

enum RoundingMethod {
  NORMAL
  TRUNCATE_TO_UNIT
}

// ── Analysis Dimension enums ─────────────────────────────────────────────────

enum DimensionValidationType {
  NONE
  LIST
  RANGE
}

// ── Period Close Status enum ─────────────────────────────────────────────────

enum PeriodCloseState {
  PC_OPEN
  SOFT_CLOSE
  HARD_CLOSE
  PC_LOCKED
}

enum JournalSource {
  MANUAL
  PMS
  POS
  PAYROLL
  FX_REVAL
  AP
  AR
  // Added per Financials Admin spec FA-ENUM-001 — used by Transfer Desk imports
  // and period-end processes for filtering and reporting.
  IMPORT // Generic Transfer Desk profile import
  SYSTM // System-generated (rounding, balancing, automatic adjustments)
  PAYMT // Payment run posting (bank disbursement leg)
  PAYDS // Payment discount (early-pay discount taken)
  DEPRC // Fixed-asset depreciation batch
  ALLOC // Corporate allocation batch
  REVAL // FX revaluation (replaces FX_REVAL going forward; kept for backward compat)
  COLLN // Payment collection run (AR direct debit / receipt batch)
  YEAREND // Year-end P&L cleardown to retained earnings
  INTERCO // Intercompany cross-entity journal
}

enum JournalStatus {
  DRAFT
  PENDING_APPROVAL
  POSTED
  REVERSED
  RETURNED
  VOIDED
}

enum TransferBatchStatus {
  PENDING_REVIEW
  /// Commit is in progress. Set before any item is posted and cleared only
  /// once every item has been processed, so a commit interrupted mid-way can
  /// be resumed rather than leaving items stranded in a COMMITTED batch.
  COMMITTING
  COMMITTED
  DISCARDED
}

enum TransferBatchItemStatus {
  HELD
  COMMITTED
  REJECTED
  ERROR
}

enum TransferValidationStatus {
  OK
  WARNING
  ERROR
}

enum TransferReviewMode {
  HOLD
  AUTO_COMMIT
}

enum RejectionReturnsTo {
  PREVIOUS_STAGE
  ORIGINATOR
  SPECIFIC_STAGE
}

enum AuthorizationDecisionStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum AuthorizationSetStatus {
  OPEN
  SUBMITTED
  APPROVED
  REJECTED
}

enum WorkflowModule {
  GL
  AP
  AR
}

enum JournalApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportType {
  USALI_PL
  TRIAL_BALANCE
  BALANCE_SHEET
  CASHFLOW
  CUSTOM
  FAL
  FSL
  FTL
}

enum ReportRunStatus {
  QUEUED
  RUNNING
  COMPLETE
  FAILED
}

enum APInvoiceStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  POSTED
  PAID
  DISPUTED
  CANCELLED
}

enum PurchaseOrderStatus {
  OPEN
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum PaymentRunStatus {
  PROPOSED
  APPROVED
  CONFIRMED
  PROCESSED
  FAILED
  CANCELLED
}

enum PaymentFileFormat {
  SWIFT_MT103
  SEPA_PAIN001
  CSV
}

enum PaymentMethod {
  BANK_TRANSFER
  CHEQUE
  CARD
  CASH
}

enum CustomerType {
  CORPORATE
  OTA
  TRAVEL_AGENT
  INDIVIDUAL
}

enum ARInvoiceStatus {
  DRAFT
  POSTED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum FXRateType {
  SPOT
  AVERAGE
  BUDGET
  CLOSING
}

enum FXRateSource {
  ECB
  OANDA
  MANUAL
  OPEN_ER_API
}

// ── Corporate Allocation enums ──────────────────────────────────────────────

enum AllocationType {
  CHARGE // Target posting + offset account; source untouched
  SPLIT // Target posting + reversal on source; source zeroed
}

enum AllocationBasisType {
  FIXED_PERCENTAGE // User-defined % per target
  FIXED_AMOUNT // User-defined absolute amount per target
  ACCOUNT_BALANCE // Ratio derived from ledger balances (ratio accounts)
  STATISTICAL_KEY // Ratio derived from statistical account values
}

enum AllocationBalanceType {
  OPENING // Opening balance of the period
  MOVEMENTS // In-period movements only
  CLOSING // Closing balance (opening + movements)
}

// ── Fixed Asset enums ───────────────────────────────────────────────────────

enum DepreciationMethod {
  STRAIGHT_LINE
  REDUCING_BALANCE
  SUM_OF_DIGITS
  USER_TABLE // Custom depreciation curve (stub — future sprint)
  NONE // No depreciation (land, art, etc.)
}

enum AssetStatus {
  ACTIVE
  FULLY_DEPRECIATED
  DISPOSED
}

// ─── Tenant Setup ────────────────────────────────────────────────────────────

model TenantSetupProgress {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  currentStep    Int       @default(1) @map("current_step")
  isCompleted    Boolean   @default(false) @map("is_completed")
  stepData       Json      @default("{}") @map("step_data")
  completedSteps Int[]     @default([]) @map("completed_steps")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("tenant_setup_progress")
}

// ─── Core Tenant / Auth Models ────────────────────────────────────────────────

model Entity {
  id                 String     @id @default(uuid())
  name               String
  /// Short business-unit code (e.g. "JUM", "DIFC", "PALM"). Unique within parent group.
  /// Equivalent to SunSystems "Business Unit" code. Used in reports and consolidation.
  code               String?    @db.VarChar(20)
  type               EntityType
  functionalCurrency String     @default("USD") @map("functional_currency")
  reportingCurrency  String     @default("USD") @map("reporting_currency")
  timezone           String     @default("UTC")
  countryCode        String     @map("country_code")
  address            String?
  city               String?
  postalCode         String?    @map("postal_code")
  isActive           Boolean    @default(true) @map("is_active")
  /// Maximum number of PROPERTY children allowed (licensing). Only on GROUP entities. 0 = unlimited.
  maxProperties      Int        @default(0) @map("max_properties")
  parentId           String?    @map("parent_id")
  parent             Entity?    @relation("EntityHierarchy", fields: [parentId], references: [id])
  children           Entity[]   @relation("EntityHierarchy")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  // Relations
  users                    EntityUser[]
  userRoles                UserRole[]
  periods                  Period[]
  accounts                 Account[]
  journals                 Journal[]
  accountBalances          AccountPeriodBalance[]
  approvalRules            ApprovalRule[]
  journalApprovals         JournalApproval[]
  auditEvents              AuditEvent[]
  reportDefinitions        ReportDefinition[]
  apInvoices               APInvoice[]
  arInvoices               ARInvoice[]
  apPayments               APPayment[]
  suppliers                Supplier[]
  purchaseOrders           PurchaseOrder[]
  goodsReceivedNotes       GoodsReceivedNote[]
  paymentRuns              PaymentRun[]
  customers                Customer[]
  arReceipts               ARReceipt[]
  budgetDefinitions        BudgetDefinition[]
  connectorMappings        ConnectorMapping[]
  importLogs               ImportLog[]
  interfaceDefinitions     InterfaceDefinition[]
  pmsStatistics            PMSStatistic[]
  bankStatements           BankStatement[]
  consolidationParentRuns  ConsolidationRun[]        @relation("ConsolidationParent")
  consolidationEntityRuns  ConsolidationRunEntity[]  @relation("ConsolidationEntity")
  journalTypes             JournalType[]
  recurringJournals        RecurringJournal[]
  accountTypeDefinitions   AccountTypeDefinition[]
  ledgerSetups             LedgerSetup[]
  processLocks             ProcessLock[]
  periodCloseStatuses      PeriodCloseStatus[]
  analysisDimensions       AnalysisDimension[]
  allocationDefinitions    AllocationDefinition[]
  fixedAssets              FixedAsset[]
  assetCategories          AssetCategory[]
  depreciationTables       DepreciationTable[]
  authorizationStages      AuthorizationStage[]
  authorizationTeams       AuthorizationTeam[]
  authorizationDelegations AuthorizationDelegation[]
  rejectionCodes           RejectionCode[]
  authorizationSets        AuthorizationSet[]
  journalAuthorizations    JournalAuthorization[]
  yearEndConfigs           YearEndConfig[]
  icAccountPairsOwned      IntercompanyAccountPair[] @relation("ICPairOwner")
  icAccountPairsCounter    IntercompanyAccountPair[] @relation("ICPairCounterparty")
  icJournalsSource         IntercompanyJournal[]     @relation("ICJournalSource")
  icJournalsMirror         IntercompanyJournal[]     @relation("ICJournalMirror")
  icPairsAsA               ICEntityPair[]            @relation("ICPairEntityA")
  icPairsAsB               ICEntityPair[]            @relation("ICPairEntityB")
  icTxnsInitiated          ICTransaction[]           @relation("ICTxnInitiator")
  icTxnsCounterparty       ICTransaction[]           @relation("ICTxnCounterparty")
  paymentProfiles          PaymentProfile[]
  revaluationProfiles      RevaluationProfile[]
  bankAccounts             BankAccount[]
  taxCodes                 TaxCode[]

  @@index([parentId])
  @@map("entities")
}

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  keycloakId  String?   @unique @map("keycloak_id") // Nullable: not needed for native auth users
  name        String
  phone       String?
  jobTitle    String?   @map("job_title")
  department  String?
  avatarUrl   String?   @map("avatar_url")
  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at")
  lastLoginIp String?   @map("last_login_ip") @db.VarChar(45)
  loginCount  Int       @default(0) @map("login_count")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Native auth fields
  passwordHash         String?   @map("password_hash") @db.VarChar(255)
  passwordChangedAt    DateTime? @map("password_changed_at")
  failedLoginAttempts  Int       @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime? @map("locked_until")
  mustChangePassword   Boolean   @default(false) @map("must_change_password")
  passwordResetToken   String?   @map("password_reset_token") @db.VarChar(255)
  passwordResetExpires DateTime? @map("password_reset_expires")

  entities                     EntityUser[]
  roles                        UserRole[]
  createdJournals              Journal[]                 @relation("JournalCreatedBy")
  approvedJournals             Journal[]                 @relation("JournalApprovedBy")
  journalApprovals             JournalApproval[]
  auditEvents                  AuditEvent[]
  loginAudits                  LoginAudit[]
  recurringJournals            RecurringJournal[]        @relation("RecurringJournalCreatedBy")
  processLocks                 ProcessLock[]
  periodCloseStatuses          PeriodCloseStatus[]
  allocationDefinitions        AllocationDefinition[]    @relation("AllocationCreatedBy")
  fixedAssets                  FixedAsset[]              @relation("AssetCreatedBy")
  authorizationTeamMembers     AuthorizationTeamMember[]
  authorizationDelegationsFrom AuthorizationDelegation[] @relation("DelegationFrom")
  authorizationDelegationsTo   AuthorizationDelegation[] @relation("DelegationTo")
  authorizationSetsCreated     AuthorizationSet[]        @relation("AuthSetCreatedBy")
  journalAuthDecisions         JournalAuthorization[]    @relation("AuthDecidedBy")

  @@map("users")
}

model LoginAudit {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  email     String
  action    String // LOGIN_SUCCESS, LOGIN_FAILED, LOGOUT, TOKEN_REFRESH, PASSWORD_RESET_REQUEST
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  entityId  String?  @map("entity_id")
  metadata  Json? // extra info (e.g., failure reason)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@map("login_audits")
}

model EntityUser {
  entityId  String     @map("entity_id")
  userId    String     @map("user_id")
  role      EntityRole? // Deprecated: roles now assigned via UserRole table
  createdAt DateTime    @default(now()) @map("created_at")
  entity    Entity     @relation(fields: [entityId], references: [id])
  user      User       @relation(fields: [userId], references: [id])

  @@id([entityId, userId])
  @@index([userId])
  @@map("entity_users")
}

model Role {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  description String?
  category    String?          @map("category")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  entityId  String?  @map("entity_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])
  entity    Entity?  @relation(fields: [entityId], references: [id])

  @@unique([userId, roleId, entityId])
  @@index([entityId])
  @@map("user_roles")
}

// ─── Period Management ────────────────────────────────────────────────────────

model Period {
  id                    String                 @id @default(uuid())
  entityId              String                 @map("entity_id")
  year                  Int
  month                 Int
  name                  String
  status                PeriodStatus           @default(OPEN)
  openedAt              DateTime?              @map("opened_at")
  closedAt              DateTime?              @map("closed_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  entity                Entity                 @relation(fields: [entityId], references: [id])
  journals              Journal[]
  balances              AccountPeriodBalance[]
  apInvoices            APInvoice[]
  ledgerSetups          LedgerSetup[]
  periodCloseStatuses   PeriodCloseStatus[]
  allocationDefinitions AllocationDefinition[]
  fixedAssets           FixedAsset[]

  @@unique([entityId, year, month])
  @@index([entityId, status])
  @@map("periods")
}

// ─── General Ledger ───────────────────────────────────────────────────────────

// ── Account Type Definition (database-driven, replaces hardcoded enum) ────────

model AccountTypeDefinition {
  id            String              @id @default(uuid())
  code          String              @db.VarChar(30)
  name          String              @db.VarChar(100)
  category      AccountTypeCategory
  normalBalance NormalBalance       @map("normal_balance")
  isSystem      Boolean             @default(false) @map("is_system")
  sortOrder     Int                 @default(0) @map("sort_order")
  isActive      Boolean             @default(true) @map("is_active")
  entityId      String?             @map("entity_id")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  entity   Entity?   @relation(fields: [entityId], references: [id])
  accounts Account[]

  @@unique([entityId, code])
  @@map("account_type_definitions")
}

model Account {
  id                    String                 @id @default(uuid())
  entityId              String                 @map("entity_id")
  code                  String
  name                  String
  /// Account type code (e.g. "ASSET", "REVENUE", or custom). References AccountTypeDefinition.code.
  type                  String
  accountTypeDefId      String?                @map("account_type_def_id")
  usaliCategory         String?                @map("usali_category")
  usaliDepartment       String?                @map("usali_department")
  normalBalance         NormalBalance          @map("normal_balance")
  allowPosting          Boolean                @default(true) @map("allow_posting")
  allowedSources        JournalSource[]        @default([]) @map("allowed_sources")
  isControlAccount      Boolean                @default(false) @map("is_control_account")
  isActive              Boolean                @default(true) @map("is_active")
  parentId              String?                @map("parent_id")
  level                 Int                    @default(1)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  entity                Entity                 @relation(fields: [entityId], references: [id])
  accountTypeDef        AccountTypeDefinition? @relation(fields: [accountTypeDefId], references: [id])
  parent                Account?               @relation("AccountHierarchy", fields: [parentId], references: [id])
  children              Account[]              @relation("AccountHierarchy")
  journalLines          JournalLine[]
  periodBalances        AccountPeriodBalance[]
  apInvoiceLines        APInvoiceLine[]
  budgetLines           BudgetLine[]
  connectorMappings     ConnectorMapping[]
  bankStatements        BankStatement[]
  recurringJournalLines RecurringJournalLine[]
  bankAccounts          BankAccount[]
  taxCodesAsInput       TaxCode[]              @relation("TaxCodeInputAccount")
  taxCodesAsOutput      TaxCode[]              @relation("TaxCodeOutputAccount")

  @@unique([entityId, code])
  @@index([entityId, parentId])
  @@map("accounts")
}

// ── Journal Type (configurable per-entity) ─────────────────────────────────

model JournalType {
  id                    String          @id @default(uuid())
  entityId              String          @map("entity_id")
  code                  String          @db.VarChar(10)
  name                  String          @db.VarChar(100)
  description           String?         @db.VarChar(500)
  /// Which JournalSource values are allowed for this type (empty = unrestricted)
  allowedSources        JournalSource[] @default([]) @map("allowed_sources")
  /// Which account type codes can appear on lines (empty = unrestricted)
  allowedAccountTypes   String[]        @default([]) @map("allowed_account_types")
  /// Prefix for auto-numbering (e.g. "RV" → RV-2026-0001)
  numberPrefix          String          @map("number_prefix") @db.VarChar(10)
  /// Auto-reverse in the next open period on posting
  autoReverse           Boolean         @default(false) @map("auto_reverse")
  /// Whether journals of this type require debit/credit balance (false for statistical)
  requireBalance        Boolean         @default(true) @map("require_balance")
  /// Whether journals of this type require multi-stage authorization before posting
  authorizationRequired Boolean         @default(false) @map("authorization_required")
  isActive              Boolean         @default(true) @map("is_active")
  /// Auto-increment counter for this type's numbering (per entity)
  nextNumber            Int             @default(1) @map("next_number")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  entity              Entity               @relation(fields: [entityId], references: [id])
  journals            Journal[]
  authorizationStages AuthorizationStage[]

  @@unique([entityId, code])
  @@map("journal_types")
}

model RecurringJournal {
  id                 String        @id @default(uuid())
  entityId           String        @map("entity_id")
  name               String        @db.VarChar(200)
  description        String?
  journalTypeId      String?       @map("journal_type_id")
  source             JournalSource @default(MANUAL)
  functionalCurrency String        @map("functional_currency") @db.Char(3)
  /// Cron-like frequency: MONTHLY, QUARTERLY, ANNUALLY
  frequency          String        @db.VarChar(20)
  /// Day of month to generate (1-28, or 0 for last day)
  dayOfMonth         Int           @default(1) @map("day_of_month")
  /// Auto-post generated journals (false = create as DRAFT)
  autoPost           Boolean       @default(false) @map("auto_post")
  /// Auto-reverse in the next period
  autoReverse        Boolean       @default(false) @map("auto_reverse")
  /// How many times to run (0 = unlimited)
  maxOccurrences     Int           @default(0) @map("max_occurrences")
  /// How many times this has run
  occurrenceCount    Int           @default(0) @map("occurrence_count")
  /// Date of last generation
  lastGeneratedAt    DateTime?     @map("last_generated_at")
  /// Date after which no more journals are generated
  endDate            DateTime?     @map("end_date")
  isActive           Boolean       @default(true) @map("is_active")
  createdById        String        @map("created_by")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  entity    Entity                 @relation(fields: [entityId], references: [id])
  createdBy User                   @relation("RecurringJournalCreatedBy", fields: [createdById], references: [id])
  lines     RecurringJournalLine[]

  @@index([entityId, isActive])
  @@map("recurring_journals")
}

model RecurringJournalLine {
  id                 String  @id @default(uuid())
  recurringJournalId String  @map("recurring_journal_id")
  accountId          String  @map("account_id")
  debit              Decimal @db.Decimal(18, 4)
  credit             Decimal @db.Decimal(18, 4)
  currency           String  @db.Char(3)
  fxRate             Decimal @default(1) @map("fx_rate") @db.Decimal(14, 8)
  description        String?
  dimension1         String? @db.VarChar(50)
  dimension2         String? @db.VarChar(50)
  dimension3         String? @db.VarChar(50)
  dimension4         String? @db.VarChar(50)
  dimension5         String? @db.VarChar(50)
  dimension6         String? @db.VarChar(50)
  dimension7         String? @db.VarChar(50)
  dimension8         String? @db.VarChar(50)
  dimension9         String? @db.VarChar(50)
  dimension10        String? @db.VarChar(50)
  lineNumber         Int     @map("line_number")

  recurringJournal RecurringJournal @relation(fields: [recurringJournalId], references: [id], onDelete: Cascade)
  account          Account          @relation(fields: [accountId], references: [id])

  @@map("recurring_journal_lines")
}

model Journal {
  id                    String                 @id @default(uuid())
  entityId              String                 @map("entity_id")
  periodId              String                 @map("period_id")
  journalTypeId         String?                @map("journal_type_id")
  reference             String?
  description           String?
  source                JournalSource
  status                JournalStatus          @default(DRAFT)
  postedAt              DateTime?              @map("posted_at")
  functionalCurrency    String                 @map("functional_currency")
  createdById           String                 @map("created_by")
  approvedById          String?                @map("approved_by")
  /// Current authorization stage sequence order (null = not in authorization workflow)
  currentAuthStageOrder Int?                   @map("current_auth_stage_order")
  /// Authorization set this journal belongs to (for batch approval)
  authorizationSetId    String?                @map("authorization_set_id")
  /// Auto-reversal flag: if true, a mirrored reversal journal is created in the next period
  isAutoReversible      Boolean                @default(false) @map("is_auto_reversible")
  /// Self-reference to the original journal this entry reverses (for auto-reversal tracking)
  reversalOfId          String?                @map("reversal_of_id")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  entity                Entity                 @relation(fields: [entityId], references: [id])
  period                Period                 @relation(fields: [periodId], references: [id])
  journalType           JournalType?           @relation(fields: [journalTypeId], references: [id])
  createdBy             User                   @relation("JournalCreatedBy", fields: [createdById], references: [id])
  approvedBy            User?                  @relation("JournalApprovedBy", fields: [approvedById], references: [id])
  authorizationSet      AuthorizationSet?      @relation(fields: [authorizationSetId], references: [id])
  reversalOf            Journal?               @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversals             Journal[]              @relation("JournalReversal")
  lines                 JournalLine[]
  approvals             JournalApproval[]
  authorizations        JournalAuthorization[]
  icSourceJournals      IntercompanyJournal[]  @relation("ICSourceJournal")
  icMirrorJournals      IntercompanyJournal[]  @relation("ICMirrorJournal")
  icTxnInitiatorJournals   ICTransaction[]    @relation("ICTxnInitiatorJournal")
  icTxnCounterpartyJournals ICTransaction[]   @relation("ICTxnCounterpartyJournal")

  @@index([entityId, periodId, status])
  @@index([entityId, createdAt])
  @@index([entityId, journalTypeId])
  @@index([entityId, authorizationSetId])
  @@map("journals")
}

model JournalLine {
  id               String            @id @default(uuid())
  journalId        String            @map("journal_id")
  accountId        String            @map("account_id")
  debit            Decimal           @db.Decimal(18, 4)
  credit           Decimal           @db.Decimal(18, 4)
  /// Statistical value for STATISTICAL-type account postings (memo accounts).
  /// Financial postings leave this NULL. For stats imports: debit=0, credit=0,
  /// statValue holds the parsed quantity (÷1000 from SAF).
  statValue        Decimal?          @map("stat_value") @db.Decimal(18, 3)
  currency         String            @db.Char(3)
  fxRate           Decimal           @default(1) @map("fx_rate") @db.Decimal(14, 8)
  debitFunctional  Decimal           @default(0) @map("debit_functional") @db.Decimal(18, 4)
  creditFunctional Decimal           @default(0) @map("credit_functional") @db.Decimal(18, 4)
  description      String?
  dimension1       String?           @db.VarChar(50)
  dimension2       String?           @db.VarChar(50)
  dimension3       String?           @db.VarChar(50)
  dimension4       String?           @db.VarChar(50)
  dimension5       String?           @db.VarChar(50)
  dimension6       String?           @db.VarChar(50)
  dimension7       String?           @db.VarChar(50)
  dimension8       String?           @db.VarChar(50)
  dimension9       String?           @db.VarChar(50)
  dimension10      String?           @db.VarChar(50)
  lineNumber       Int               @map("line_number")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  journal          Journal           @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account          Account           @relation(fields: [accountId], references: [id])
  bankTransactions BankTransaction[]

  @@index([journalId, lineNumber])
  @@index([accountId])
  @@map("journal_lines")
}

model AccountPeriodBalance {
  id             String   @id @default(uuid())
  entityId       String   @map("entity_id")
  accountId      String   @map("account_id")
  periodId       String   @map("period_id")
