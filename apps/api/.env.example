PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://hfp:password@localhost:5432/hfp_db
REGISTRY_DATABASE_URL=postgresql://hfp:password@localhost:5432/hfp_registry
ALLOWED_ORIGINS=http://localhost:3001

# Native Auth / JWT Session Settings
JWT_SECRET=generate-with-node-e-require-crypto-randomBytes-32-toString-hex
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800
BCRYPT_SALT_ROUNDS=12
MAX_FAILED_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Optional RabbitMQ event bus
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EVENTS_EXCHANGE=hfp.events
APP_BASE_URL=http://localhost:3001
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@hospitalityfinancepro.com

# Required in production for native auth sessions, refresh-token revocation, BullMQ, and caches.
REDIS_URL=redis://localhost:6379
STORAGE_BACKEND=local
# Local storage must stay outside any public web root such as apps/web/public.
TD_LOCAL_UPLOADS_PATH=./uploads
AWS_REGION=us-east-1
AWS_S3_BUCKET=hfp-dev-files
TD_S3_BUCKET=hfp-transfer-desk
AP_MATCH_TOLERANCE_PCT=2
