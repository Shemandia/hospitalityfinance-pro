API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Platform machine key (must match the API's PLATFORM_API_KEY)
HFP_PLATFORM_KEY=change-me

# Platform admin operator account (username/password login for /platform pages).
# Generate the hash with:
#   node -e "const{randomBytes,scryptSync}=require('node:crypto');const s=randomBytes(16);console.log('scrypt:'+s.toString('hex')+':'+scryptSync(process.argv[1],s,32).toString('hex'))" "<password>"
PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_PASSWORD_HASH=scrypt:<salt-hex>:<hash-hex>
