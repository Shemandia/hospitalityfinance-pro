PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://hfp:password@localhost:5432/hfp_db
REGISTRY_DATABASE_URL=postgresql://hfp:password@localhost:5432/hfp_registry
# The browser reaches the API only through the web app's proxy (same origin).
# Addresses whose X-Forwarded-* headers are believed: the web app's server.
# Default "loopback" fits the web app and the API on one machine.
TRUST_PROXY=loopback

# Native Auth / JWT Session Settings (JWT_SECRET: at least 32 characters)
JWT_SECRET=generate-with-node-e-require-crypto-randomBytes-32-toString-hex
# Key the platform admin (the web app's /platform pages) sends to the tenant routes.
# Required: the API does not start without it. Must match HFP_PLATFORM_KEY in apps/web/.env.local.
PLATFORM_API_KEY=generate-with-node-e-require-crypto-randomBytes-32-toString-hex
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800
BCRYPT_SALT_ROUNDS=12
MAX_FAILED_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
COOKIE_SECURE=false

# The address users open in the browser (links in e-mails, and the sign-in
# link pnpm dev:setup prints).
APP_BASE_URL=http://localhost:3000

# Development only: the demo users' password, set by pnpm dev:setup / db:seed.
# At least 12 characters with an upper-case letter, a lower-case letter and a digit.
SEED_USER_PASSWORD=
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@hospitalityfinancepro.com

# Required in production for native auth sessions, refresh-token revocation, BullMQ, and caches.
REDIS_URL=redis://localhost:6379
# Lifetime of a cached access result. Changes to roles and assignments invalidate
# the cache explicitly; this is only the backstop. Default 300.
ACCESS_CACHE_TTL_SECONDS=300
STORAGE_BACKEND=local
# Local storage must stay outside any public web root such as apps/web/public.
TD_LOCAL_UPLOADS_PATH=./uploads
AWS_REGION=us-east-1
AWS_S3_BUCKET=hfp-dev-files
TD_S3_BUCKET=hfp-transfer-desk
