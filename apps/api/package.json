{
  "name": "@hfp/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node --env-file-if-exists=.env -e \"if(!process.env.TEST_DATABASE_URL){console.error('TEST_DATABASE_URL is required for integration tests');process.exit(1)}\" && node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run tests/integration",
    "db:generate": "prisma generate --schema src/db/schema-registry.prisma && prisma generate --schema src/db/schema-tenant.prisma",
    "db:generate:registry": "prisma generate --schema src/db/schema-registry.prisma",
    "db:generate:tenant": "prisma generate --schema src/db/schema-tenant.prisma",
    "db:push:registry": "prisma db push --schema src/db/schema-registry.prisma",
    "db:push:tenant": "prisma db push --schema src/db/schema-tenant.prisma",
    "db:migrate": "prisma migrate dev --schema src/db/schema-registry.prisma && prisma migrate dev --schema src/db/schema-tenant.prisma",
    "db:migrate:deploy:registry": "prisma migrate deploy --schema src/db/schema-registry.prisma",
    "db:migrate:deploy:tenant": "prisma migrate deploy --schema src/db/schema-tenant.prisma",
    "db:setup:tenant": "pnpm run db:migrate:deploy:tenant && pnpm run db:setup:rls && pnpm run db:setup:audit && pnpm run db:setup:performance",
    "db:migrate:access": "prisma db execute --schema src/db/schema-tenant.prisma --file src/db/migrations/20261111000000_role_assignments/migration.sql",
    "db:setup:test": "prisma db push --schema src/db/schema-tenant.prisma --skip-generate && pnpm run db:setup:rls && pnpm run db:setup:audit && pnpm run db:setup:performance && pnpm run db:migrate:access",
    "db:seed": "tsx src/db/seed.ts",
    "db:setup:audit": "tsx src/db/setupAuditImmutability.ts",
    "db:setup:rls": "tsx src/db/setupEntityRls.ts",
    "db:setup:performance": "tsx src/db/setupPerformance.ts",
    "report:worker": "tsx src/jobs/report-generation-worker.ts",
    "dunning:worker": "tsx src/jobs/dunning-worker.ts",
    "scheduled-reports:worker": "tsx src/jobs/scheduled-reports-worker.ts",
    "workers": "tsx src/jobs/worker-supervisor.ts",
    "workers:prod": "node dist/jobs/worker-supervisor.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.907.0",
    "@aws-sdk/client-ses": "^3.1029.0",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "9",
    "@hfp/fsd-engine": "workspace:^",
    "@hfp/tml-engine": "workspace:^",
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^4.3.2",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.58.5",
    "fastify": "^4.28.1",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.10.1",
    "jose": "^5.9.6",
    "jsonwebtoken": "^9.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "ssh2-sftp-client": "^10.0.3",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.2",
    "@types/ssh2-sftp-client": "^9.0.4",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "prisma": {
    "seed": "tsx src/db/seed.ts"
  }
}
